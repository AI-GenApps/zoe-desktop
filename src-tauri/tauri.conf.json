{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zoe Agent",
  "version": "0.1.0",
  "identifier": "app.zybernetix.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "trayIcon": {
      "iconPath": "../assets/tray-icon.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "label": "main",
        "title": "Zoe Agent",
        "width": 900,
        "height": 650,
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://releases.zybernetix.w3dev.email/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5OEJFOTMwMjFEQjg1MDMKUldRRGhkc2hNT21MMlduU3VTWkw0QVgrSUQxSkVuRlAxS0YyU09tdzB4UTUzZElEZWc3VFRGc2gK",
      "dialog": false
    }
  }
}
