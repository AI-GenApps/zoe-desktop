# Environment variables for Zoe Agent (Tauri + Vite)
#
# BOUNDARY: Variables prefixed VITE_ are inlined into the JS bundle by Vite at build time
# and are visible to anyone who inspects the binary. Do not put secrets under VITE_.
# Secrets (refresh token, HMAC secret in production) must use Tauri Stronghold or OS keychain APIs.
#
# USAGE: Copy this file to .env.local (or run `pnpm env:link` from the repo root to symlink
# the shared root .env.local). The `pnpm env:link` command is for local development only;
# in CI inject vars via GitHub Actions secrets or Vercel environment variables.

# ── Vite / frontend bundle (exposed to JS, MUST be prefixed VITE_) ─────────
# Base URL of the member dashboard API (no trailing slash)
VITE_API_BASE_URL=http://localhost:4510

# PostHog project key is public and is embedded into the desktop bundle.
# Leave blank to disable telemetry locally. Autocapture and session recording remain disabled.
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Tauri updater signing key (public key embedded in tauri.conf.json; private key
# used only in CI — never commit the private key)
TAURI_SIGNING_PUBLIC_KEY=
TAURI_SIGNING_PRIVATE_KEY=

# ── Secrets that MUST NOT live in env files ────────────────────────────────
# REFRESH_TOKEN  — stored in OS keychain via tauri-plugin-stronghold (epic 01-auth-otp)
# ACCESS_TOKEN   — held in memory only; never written to disk or env
# OTP            — never stored anywhere
